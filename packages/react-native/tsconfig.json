{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // `blobatar` resolves to source here, the same way the other adapters and
    // the apps do it, so editing the renderer shows up without a build in
    // between. What *ships* resolves through the real `exports` map.
    // `tsconfig.build.json` clears these paths for the declaration emit, and
    // `scripts/build.ts` externalizes `blobatar` entirely.
    "paths": {
      "blobatar": ["../blobatar/src/index.ts"],
      "blobatar/internal": ["../blobatar/src/internal.ts"]
    }
  },
  "include": ["src", "scripts"]
}
