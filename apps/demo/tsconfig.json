{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The tuning grid reads the library from source, not from `dist`. Bun's
    // bundler honours these, so a change to `src/shape.ts` reaches the grid on
    // save — which is the whole point of the grid. The package's own `exports`
    // deliberately point at built JS, so without this alias every edit here
    // would need a rebuild first.
    "paths": {
      "blobatar": ["../../packages/blobatar/src/index.ts"],
      "blobatar/blob": ["../../packages/blobatar/src/blob.ts"],
      "blobatar/uri": ["../../packages/blobatar/src/uri.ts"],
      "blobatar/expression": ["../../packages/blobatar/src/expression.ts"],
      "@blobatar/react": ["../../packages/react/src/index.tsx"],
      "@blobatar/react/gaze": ["../../packages/react/src/gaze.ts"],
      "blobatar/react": ["../../packages/blobatar/src/react.tsx"],
      "blobatar/gaze": ["../../packages/blobatar/src/gaze.ts"],
      "blobatar/motion.css": ["../../packages/blobatar/src/motion.css"],
      "blobatar/gaze.css": ["../../packages/blobatar/src/gaze.css"]
    }
  },
  // `bun-env.d.ts` carries the ambient `*.css` / `*.svg` declarations. It
  // lives at the root, where the root config picks it up by including
  // everything, and an app that narrows `include` to its own directory drops
  // it: every `import "./styles.css"` then fails with TS2882 even though the
  // declaration exists three directories up.
  "include": [".", "../../bun-env.d.ts"]
}
